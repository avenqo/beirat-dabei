# Beispielwerte. Kopieren nach .env und anpassen. Die .env nie committen.

# Öffentliche Adresse der Instanz (ohne Schrägstrich am Ende). Dashboard unter /dashboard/,
# Admin-Oberfläche unter /admin. TLS macht der Reverse Proxy des Servers.
PUBLIC_URL=https://umweltbeirat.example.de
# Port, auf dem der Stack lokal lauscht (dahinter der Reverse Proxy)
PORT=8055
# Sitzungs-Cookie nur über HTTPS senden. Nur für lokale Tests mit http auf false setzen.
SESSION_COOKIE_SECURE=true

# Directus-Schlüssel, zufällig erzeugen: openssl rand -hex 32
KEY=
SECRET=

# Erster Administrator (wird beim ersten Start angelegt)
ADMIN_EMAIL=admin@example.de
ADMIN_PASSWORD=

# Versand
# Mit Anzeigename, sonst erscheint "Directus" als Absender
EMAIL_FROM='Umweltbeirat Kremmen <umweltbeirat@example.de>'
EMAIL_SMTP_HOST=smtp.example.de
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false

# Schlüssel zum Signieren der Magic Links: openssl rand -hex 32
MAGIC_LINK_SECRET=
# Links in Mails gelten bis zum Sitzungsende plus Nachlauf. Der Rückgängig-Link gilt 30 Minuten.
MAGIC_LINK_NACHLAUF_TAGE=14
SITZUNGSDAUER_STUNDEN=3

# Basisadresse des Dashboards (Standard: PUBLIC_URL + /dashboard)
# DASHBOARD_URL=

# Benachrichtigungen: aus | trocken (nur ins Log schreiben) | scharf (versenden)
# Erst auf "scharf" stellen, wenn die Sitzungen im System stimmen.
REGELN_MODUS=trocken
# Täglicher Lauf (cron, Zeitzone TZ)
# REGELN_CRON=0 7 * * *

# RIS-Abgleich: aus | trocken (nur ins Log schreiben) | scharf (Sitzungen anlegen und ändern)
# Adapter und Adresse des RIS stehen in den Einstellungen (ris_adapter, ris_quelle).
RIS_MODUS=trocken
# Dreimal täglich, danach laufen die Regeln, falls sich etwas geändert hat
# RIS_CRON=15 6,12,18 * * *
# Wie weit der Abgleich zurückschaut, damit die letzte Sitzung für nachträgliche Notizen erscheint
# RIS_RUECKBLICK_TAGE=45
# Erkennbarer User-Agent für Abrufe beim RIS (Standard: beirat-dabei/0.1 + PUBLIC_URL)
# RIS_USER_AGENT=

TZ=Europe/Berlin

# Rollennamen dieser Instanz (Extension und scripts/schema-anwenden.mjs)
ROLLE_MITGLIED=ub
ROLLE_ADMIN=ub-admin
