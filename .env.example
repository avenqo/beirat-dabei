# Beispielwerte. Kopieren nach .env und anpassen. Die .env nie committen.

# Öffentliche Adresse der Instanz (ohne Schrägstrich am Ende)
PUBLIC_URL=https://umweltbeirat.example.de
PORT=8055

# Directus-Schlüssel, zufällig erzeugen: openssl rand -hex 32
KEY=
SECRET=

# Erster Administrator (wird beim ersten Start angelegt)
ADMIN_EMAIL=admin@example.de
ADMIN_PASSWORD=

# Versand
# Mit Anzeigename, sonst erscheint "Directus" als Absender
EMAIL_FROM="Umweltbeirat Kremmen" <umweltbeirat@example.de>
EMAIL_SMTP_HOST=smtp.example.de
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false

# Schlüssel zum Signieren der Magic Links: openssl rand -hex 32
MAGIC_LINK_SECRET=
# Links in Mails gelten bis zum Sitzungsende plus Nachlauf. Der Rückgängig-Link gilt 30 Minuten.
MAGIC_LINK_NACHLAUF_TAGE=14
SITZUNGSDAUER_STUNDEN=3

# Basisadresse des Dashboards (Standard: PUBLIC_URL + /dashboard)
# DASHBOARD_URL=

# Benachrichtigungen: aus | trocken (nur ins Log schreiben) | scharf (versenden)
# Erst auf "scharf" stellen, wenn die Sitzungen im System stimmen.
REGELN_MODUS=trocken
# Täglicher Lauf (cron, Zeitzone TZ)
# REGELN_CRON=0 7 * * *

TZ=Europe/Berlin

# Rollennamen dieser Instanz (Extension und scripts/schema-anwenden.mjs)
ROLLE_MITGLIED=ub
ROLLE_ADMIN=ub-admin
