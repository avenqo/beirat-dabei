# Beispielwerte. Kopieren nach .env und anpassen. Die .env nie committen.

# Öffentliche Adresse der Instanz (ohne Schrägstrich am Ende). Dashboard unter /dashboard/,
# Verwaltung unter /admin. TLS macht der Reverse Proxy des Servers.
PUBLIC_URL=https://beirat.example.de
# Port auf dem Host, auf dem der Stack lokal lauscht (dahinter der Reverse Proxy)
PORT=8055
# Cookies nur über HTTPS senden. Nur für lokale Tests mit http auf false setzen.
COOKIE_SECURE=true

# Schlüssel, zufällig erzeugen: openssl rand -hex 32
PAYLOAD_SECRET=
# Schlüssel zum Signieren der Links in Mails und der Kalender-Abos
MAGIC_LINK_SECRET=
# Abmeldung nach so vielen Minuten ohne Aktivität (Dashboard und Verwaltung), mindestens 5
ANMELDUNG_MINUTEN=120

# Links in Mails gelten bis zum Sitzungsende plus Nachlauf. Der Rückgängig-Link gilt 30 Minuten.
MAGIC_LINK_NACHLAUF_TAGE=14
SITZUNGSDAUER_STUNDEN=3

# Versand. EMAIL_FROM ist nur die Adresse, der Anzeigename kommt aus EMAIL_FROM_NAME.
EMAIL_FROM=beirat@example.de
EMAIL_FROM_NAME=Mein Beirat
EMAIL_SMTP_HOST=smtp.example.de
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Basisadresse des Dashboards (Standard: PUBLIC_URL + /dashboard)
# DASHBOARD_URL=

# Benachrichtigungen: aus | trocken (nur ins Log schreiben) | scharf (versenden)
# Erst auf "scharf" stellen, wenn die Sitzungen im System stimmen.
REGELN_MODUS=trocken
# Täglicher Lauf (cron, Zeitzone TZ)
# REGELN_CRON=0 7 * * *

# RIS-Abgleich: aus | trocken | scharf. Adapter und Adresse stehen in den Einstellungen.
RIS_MODUS=trocken
# RIS_CRON=15 6,12,18 * * *
# RIS_RUECKBLICK_TAGE=45
# RIS_USER_AGENT=

TZ=Europe/Berlin
