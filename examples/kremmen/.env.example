# Beispiel für die Instanz des Umweltbeirats Kremmen. Kopieren nach .env im Hauptordner
# und die leeren Werte füllen. Die .env gehört nie ins Git. Erklärungen stehen in der
# .env.example im Hauptordner.

PUBLIC_URL=https://umweltbeirat.kremmen.example
PORT=8055
SESSION_COOKIE_SECURE=true

# Jeweils mit "openssl rand -hex 32" erzeugen
KEY=
SECRET=
MAGIC_LINK_SECRET=

# Erstes Administratorkonto
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Absender und Mailserver des Beirats (Funktionsadresse, kein persönliches Konto)
EMAIL_FROM='Umweltbeirat Kremmen <umweltbeirat@kremmen.example>'
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false

TZ=Europe/Berlin

# Rollennamen, wie in instanz.yaml
ROLLE_MITGLIED=ub
ROLLE_ADMIN=ub-admin

# Links in Mails gelten bis zum Sitzungsende plus Nachlauf
MAGIC_LINK_NACHLAUF_TAGE=14
SITZUNGSDAUER_STUNDEN=3

# Erst auf "scharf" stellen, wenn die Sitzungen im Dashboard stimmen
# (siehe docs/Betrieb.md, Abschnitt "RIS-Abgleich und Benachrichtigungen umstellen")
RIS_MODUS=trocken
REGELN_MODUS=trocken
